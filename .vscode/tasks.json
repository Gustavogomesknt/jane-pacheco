{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "api: watch",
      "type": "process",
      "command": "dotnet",
      "args": ["watch", "run", "--project", "backend/JanePacheco.Api", "--no-launch-profile", "--urls", "http://localhost:5080"],
      "options": { "env": { "ASPNETCORE_ENVIRONMENT": "Development" } },
      "isBackground": true,
      "problemMatcher": "$msCompile"
    },
    {
      "label": "api: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "backend/JanePacheco.Api"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web: dev",
      "type": "npm",
      "script": "dev",
      "path": "frontend",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "dev: tudo",
      "dependsOn": ["api: watch", "web: dev"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
